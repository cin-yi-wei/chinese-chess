+  // Expand all planes to a raw float32 byte buffer of [kInputPlanes * 90]
+  // (row-major over 90 xiangqi squares: square idx = rank*9 + file). Returned
+  // as bytes so Python can np.frombuffer() with zero per-element conversion.
+  // Runs in C++ where __uint128_t works, so bits 64..89 are preserved
+  // (Python mask() truncates to 64 bits).
+  std::string expand() const {
+    std::string buf(data_.size() * 90 * sizeof(float), '\0');
+    float* out = reinterpret_cast<float*>(buf.data());
+    for (size_t p = 0; p < data_.size(); ++p) {
+      const auto mask = data_[p].mask;
+      const float v = data_[p].value;
+      for (int i = 0; i < 90; ++i) {
+        if ((mask >> i) & 1) out[p * 90 + i] = v;
+      }
+    }
+    return buf;
+  }
 
   // Not exported.
   const InputPlanes GetPlanes() const { return data_; }
